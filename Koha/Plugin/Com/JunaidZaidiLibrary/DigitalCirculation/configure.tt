[% USE raw %]
[% INCLUDE 'doc-head-open.inc' %]
<title>Digital Circulation Configuration &rsaquo; Plugins &rsaquo; Koha</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body id="plugins_jzl_digital_circulation_configure" class="plugins">
[% WRAPPER 'header.inc' %]
  [% INCLUDE 'prefs-admin-search.inc' %]
[% END %]
<div id="main" class="container-fluid">
  <nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
      <li><a href="/cgi-bin/koha/mainpage.pl">Home</a></li>
      <li><a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a></li>
      <li aria-current="page">Digital Circulation configuration</li>
    </ol>
  </nav>

  <h1>Digital Circulation configuration</h1>
  [% IF message %]<div class="alert alert-success" role="status">[% message | html %]</div>[% END %]
  [% IF error %]<div class="alert alert-danger" role="alert">[% error | html %]</div>[% END %]

  <form method="post">
    <input type="hidden" name="class" value="[% CLASS | html %]">
    <input type="hidden" name="method" value="configure">
    <input type="hidden" name="op" value="cud-save-configuration">
    <input type="hidden" name="csrf_token" value="[% csrf_token | html %]">
    <fieldset class="rows">
      <legend>Portal request service account</legend>
      <ol>
        <li>
          <label for="portal_service_account_ids">Portal service-account borrowernumbers</label>
          <input
            id="portal_service_account_ids"
            name="portal_service_account_ids"
            type="text"
            maxlength="4096"
            value="[% portal_service_account_ids | html %]"
            placeholder="123,456,789"
          >
          <span class="hint">
            Enter exact Koha borrowernumbers separated by commas. These accounts must correspond to the OAuth-authenticated portal service actor. This field does not store OAuth credentials. Leaving it blank disables portal request creation.
          </span>
        </li>
      </ol>
    </fieldset>
    <fieldset class="rows">
      <legend>Authoritative loan lifecycle</legend>
      <ol>
        <li>
          <label for="renewals_enabled">Patron renewals</label>
          <input id="renewals_enabled" name="renewals_enabled" type="checkbox" value="1" [% IF renewals_enabled %]checked[% END %]>
          <span class="hint">Disabled by default. Portal renewal also requires its portal feature flag.</span>
        </li>
        <li>
          <label for="staff_revocations_enabled">Staff revocations</label>
          <input id="staff_revocations_enabled" name="staff_revocations_enabled" type="checkbox" value="1" [% IF staff_revocations_enabled %]checked[% END %]>
          <span class="hint">Disabled by default. Authorized circulation staff may revoke ACTIVE digital loans.</span>
        </li>
        <li>
          <label for="automatic_expiry_enabled">Automatic expiry</label>
          <input id="automatic_expiry_enabled" name="automatic_expiry_enabled" type="checkbox" value="1" [% IF automatic_expiry_enabled %]checked[% END %]>
          <span class="hint">Disabled by default. The portal scheduler must also be enabled.</span>
        </li>
        <li>
          <label for="renewal_days">Renewal extension (days)</label>
          <input id="renewal_days" name="renewal_days" type="number" min="1" max="365" step="1" required value="[% renewal_days | html %]">
          <span class="hint">Added to the existing authoritative due date, never to the current time.</span>
        </li>
        <li>
          <label for="maximum_renewals">Maximum renewals</label>
          <input id="maximum_renewals" name="maximum_renewals" type="number" min="0" max="100" step="1" required value="[% maximum_renewals | html %]">
        </li>
        <li>
          <label for="expiry_batch_size">Expiry batch size</label>
          <input id="expiry_batch_size" name="expiry_batch_size" type="number" min="1" max="500" step="1" required value="[% expiry_batch_size | html %]">
        </li>
      </ol>
    </fieldset>
    <fieldset class="rows">
      <legend>Digital loan period</legend>
      <ol>
        <li>
          <label for="default_loan_duration_days">Default digital loan duration (days)</label>
          <input
            id="default_loan_duration_days"
            name="default_loan_duration_days"
            type="number"
            min="1"
            max="365"
            step="1"
            inputmode="numeric"
            value="[% default_loan_duration_days | html %]"
          >
          <span class="hint">
            Required before approved digital requests can be issued as active loans. Approval alone does not create a loan or grant protected-content access. Enter a whole number from 1 to 365, or leave blank to keep issuance unconfigured.
          </span>
        </li>
      </ol>
    </fieldset>
    <button class="btn btn-primary" type="submit">Save configuration</button>
  </form>

  <fieldset class="rows">
    <legend>Koha Saved Reports</legend>
    <ol>
      <li>
        <span class="label">Managed definitions</span>
        <span>[% reporting_status.installed_count | html %] of [% reporting_status.expected_count | html %] current</span>
        [% IF reporting_status.missing.size %]<span class="hint">Missing: [% reporting_status.missing.join(', ') | html %]</span>[% END %]
        [% IF reporting_status.drifted.size %]<span class="hint">Changed locally: [% reporting_status.drifted.join(', ') | html %]</span>[% END %]
        [% IF reporting_status.duplicates.size || reporting_status.conflicts.size %]
          <span class="hint">Repair is blocked by a naming or ownership conflict. Existing reports are not overwritten.</span>
        [% END %]
      </li>
      <li>
        <span class="label">Open reports</span>
        <a class="btn btn-default" href="[% reporting_url | html %]">Digital Circulation saved reports</a>
      </li>
    </ol>
  </fieldset>
  [% IF report_repair_allowed %]
    <form method="post" onsubmit="return confirm('Restore only Digital Circulation managed report definitions to their shipped versions? Duplicate a report first to preserve local customizations.');">
      <input type="hidden" name="class" value="[% CLASS | html %]">
      <input type="hidden" name="method" value="configure">
      <input type="hidden" name="op" value="cud-repair-managed-reports">
      <input type="hidden" name="csrf_token" value="[% csrf_token | html %]">
      <input type="hidden" name="confirm_repair" value="1">
      <button class="btn btn-default" type="submit">Repair managed report definitions</button>
    </form>
  [% END %]
</div>
[% INCLUDE 'intranet-bottom.inc' %]
