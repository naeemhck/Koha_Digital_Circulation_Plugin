[% USE raw %]
[% INCLUDE 'doc-head-open.inc' %]<title>Digital eBook Requests &rsaquo; Circulation &rsaquo; Koha</title>[% INCLUDE 'doc-head-close.inc' %]
</head><body id="jzl_digital_circulation" class="circ"><div id="wrapper">[% INCLUDE 'header.inc' %][% INCLUDE 'circ-search.inc' %]
<nav aria-label="Breadcrumb"><ol class="breadcrumb"><li><a href="/cgi-bin/koha/mainpage.pl">Home</a></li><li><a href="/cgi-bin/koha/circ/circulation-home.pl">Circulation</a></li><li aria-current="page">Digital eBook Requests</li></ol></nav>
<main id="main-content" class="container-fluid"><h1>Junaid Zaidi Library Digital eBook Requests</h1>
[% IF !authorized %]<div class="alert alert-danger" role="alert"><h2>Permission denied</h2><p>The circulation permission is required.</p></div>
[% ELSE %]
<div class="alert alert-info" role="status"><strong>Phase 2C — request decisions and loan issuance.</strong> Authorized librarians may approve or reject pending requests and may issue an ACTIVE plugin-owned digital loan from an approved request. Approval alone does not create a loan. Issuance still does not grant protected-PDF reader access or create a native Koha checkout.</div>
<div class="alert alert-warning" id="compatibility-warning" hidden role="alert">Compatibility warning: this plugin was tested with Koha [% tested_koha | html %].</div>
<form id="jzl-filters" class="form-inline" aria-label="Digital circulation filters"><label for="jzl-search">Search ID or reference</label> <input id="jzl-search" type="search" class="form-control"> <button type="submit" class="btn btn-default">Filter current view</button></form>
<ul class="nav nav-tabs" id="jzl-tabs" role="tablist">
[% FOREACH tab IN [{id=>'requests-PENDING',label=>'Pending Requests'},{id=>'requests-APPROVED',label=>'Approved Requests'},{id=>'requests-REJECTED',label=>'Rejected Requests'},{id=>'requests-CANCELLED',label=>'Cancelled Requests'},{id=>'loans-ACTIVE',label=>'Active Digital Loans'},{id=>'renewals-PENDING',label=>'Renewal Requests'},{id=>'loans-RETURNED',label=>'Returned Loans'},{id=>'loans-EXPIRED',label=>'Expired Loans'},{id=>'loans-REVOKED',label=>'Revoked Loans'},{id=>'events-',label=>'Audit Events'}] %]<li role="presentation"><button type="button" class="jzl-tab" data-view="[% tab.id | html %]">[% tab.label | html %]</button></li>[% END %]
</ul>
<div id="jzl-status" class="alert alert-info" role="status" aria-live="polite" hidden></div>
<section aria-busy="false"><h2 id="jzl-view-heading">Pending Requests</h2><p id="jzl-loading" hidden>Loading…</p><div id="jzl-error" class="alert alert-danger" role="alert" aria-live="assertive" hidden></div><div class="table-responsive"><table class="table table-striped" id="jzl-table"><caption class="sr-only">Digital circulation records</caption><thead></thead><tbody></tbody></table></div><p id="jzl-empty" hidden>No records match this view.</p><nav aria-label="Results pages" id="jzl-pagination"></nav></section>
<dialog id="jzl-reject-dialog" aria-labelledby="jzl-reject-title" aria-describedby="jzl-reject-description" hidden>
  <form id="jzl-reject-form">
    <h2 id="jzl-reject-title">Reject digital request</h2>
    <p id="jzl-reject-description">Reject request <strong id="jzl-reject-request-label"></strong>. Enter a plain-text reason.</p>
    <div class="form-group">
      <label for="jzl-reject-reason">Rejection reason <span aria-hidden="true">*</span></label>
      <textarea id="jzl-reject-reason" class="form-control" rows="5" maxlength="4096" required aria-describedby="jzl-reject-help jzl-reject-error"></textarea>
      <p id="jzl-reject-help" class="help-block">Maximum 4,096 characters. The reason is stored and displayed as plain text.</p>
      <p id="jzl-reject-error" class="text-danger" role="alert" aria-live="assertive" hidden></p>
    </div>
    <div class="jzl-dialog-actions">
      <button type="button" class="btn btn-default" id="jzl-reject-cancel">Cancel</button>
      <button type="submit" class="btn btn-danger" id="jzl-reject-submit">Reject Request</button>
    </div>
  </form>
</dialog>
<p class="text-muted">Plugin [% plugin_version | html %], schema [% schema_version | html %].</p>
[% END %]</main>[% INCLUDE 'intranet-bottom.inc' %]
[% IF authorized %]<link rel="stylesheet" href="/api/v1/contrib/jzl-digital-circulation/assets/jzl-digital-circulation-css"><script src="/api/v1/contrib/jzl-digital-circulation/assets/jzl-digital-circulation-js"></script>[% END %]</div></body></html>
